  "available_implementation_features": [
    "RV64 I/M/A/F/D/C/B scalar instruction implementation paths",
    "Zicsr/Zicntr/Zihpm CSR/counter implementation paths",
    "Zifencei instruction-fetch fence implementation paths",
    "Zicbom/Zicbop/Zicboz CBO/CMO implementation paths",
    "V vector load/store implementation paths",
    "Stage1 translation for Sv39 and Sv48, plus Svbare",
    "Svpbmt, Svinval, Svade, Sstc, Sscofpmf, Ssstateen, and related supervisor implementation paths",
    "PMP/PMA/PBMT implementation paths, excluding SMEPMP",
    "Debug trigger implementation paths through Sdtrig/Sdext where coverage source exposes memory/fetch behavior",
    "PLIC, ACLINT, etrace, and Debug platform paths when coverage/source evidence is relevant"
  ],
  "excluded_implementation_features": [
    "H extension and all HS/VS/VU/stage2/guest-page-fault paths",
    "Zacas AMOCAS and compare-and-swap instruction paths",
    "Zabha byte/halfword AMO instruction paths",
    "Zfh/Zfhmin/Zvfhmin/Zvh/Zfbfmin half-precision and BF16 paths unless a future matrix marks them supported",
    "Q and x-register floating-point variants such as Zfinx/Zdinx/Zhinxmin",
    "Sv57 and Svnapot",
    "AIA, SMEPMP, pointer masking, RAS, and H-state-enable paths"
  ],
