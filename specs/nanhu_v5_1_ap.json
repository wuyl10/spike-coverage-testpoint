{
  "name": "nanhu_v5_1_ap",
  "title": "NanHu-V5.1 AP project implementation",
  "description": "Project-level implementation contract and ISA/profile support matrix for NanHu-V5.1 AP Spike coverage analysis.",
  "environment": {
    "coverage_repo": "HYPTEST_SPIKE_COV",
    "hyptest_repo": "HYPTEST_HOME",
    "coverage_spike_bin_default": "$HYPTEST_SPIKE_COV/build/spike",
    "spike_build_dir_default": "$HYPTEST_SPIKE_COV/build",
    "gcov_raw_dir_default": "$HYPTEST_SPIKE_COV/cov_doc/gcov_raw",
    "source_root_default": "$HYPTEST_SPIKE_COV",
    "hyptest_elf_dir_default": "$HYPTEST_HOME/case_elf_asm/spike"
  },
  "implementation_model": {
    "coverage_runner": "Run existing hyptest ELF files directly with the gcov-instrumented Spike binary.",
    "compile_boundary": "Do not invoke hyptest compilation or the normal hyptest Spike runner during coverage collection.",
    "source_of_truth": "NanHu-V5.1 AP support matrix plus the selected coverage snapshot, generated .gcov files, and Spike source under HYPTEST_SPIKE_COV.",
    "summary_policy": "Coverage summary files are target/run-specific inputs and are not derived from a single global environment variable by default."
  },
  "coverage_spike": {
    "default_isa": "rv64imafdcv_zicntr_zihpm_zba_zbb_zbc_zbs_zbkb_zbkc_zbkx_zimop_zcmop_zcb_zfa_zifencei_svinval_svade_svpbmt_sstc_sscofpmf_smstateen_zicbom_zicbop_zicboz_zicond_zkn_zknd_zkne_zknh_zks_zksed_zksh_zkt",
    "default_priv": "MSU",
    "default_args": [
      "--isa={default_isa}",
      "--priv={default_priv}"
    ],
    "notes": [
      "This is the default coverage Spike runner ISA for this project spec. It includes Spike-accepted ISA/profile tokens from the NanHu-V5.1 AP support matrix that materially affect coverage execution.",
      "Do not blindly serialize every YES row from isa_profile.support into --isa: platform rows such as PLIC/ACLINT/Debug and implementation attributes are not Spike ISA tokens.",
      "The current coverage Spike binary does not accept some matrix YES labels as --isa tokens, such as Za64rs, Zic64b, Ziccrse, and Ziccamoa; keep those in the support matrix but not in default_args unless the Spike parser gains support."
    ]
  },
