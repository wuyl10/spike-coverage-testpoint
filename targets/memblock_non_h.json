{
  "name": "memblock_non_h",
  "title": "MemBlock non-H coverage target",
  "description": "Analyze Spike MemBlock-related coverage while excluding H extension and virtualization/stage2 targets.",
  "spec": {
    "profile": "memblock_non_h",
    "source_of_truth": "Target-scoped coverage planning for official/community Spike and hyptest test-point design.",
    "included_extensions_or_features": [
      "integer scalar load/store",
      "compressed memory instructions when present in Spike coverage",
      "floating-point scalar load/store when present in Spike coverage",
      "RISC-V vector load/store when present in Spike coverage",
      "LR/SC and AMO/AMOCAS when present in Spike coverage",
      "CBO/CMO when present in Spike coverage",
      "stage1 address translation",
      "PMP/PMA/PBMT",
      "trigger/debug paths involving memory access",
      "MMIO/device paths involving memory access"
    ],
    "excluded_extensions_or_features": [
      "H extension",
      "stage2 translation",
      "guest page faults",
      "HS/VS/VU virtualization targets"
    ],
    "notes": [
      "This target defines coverage-analysis scope only. hyptest implementation still needs hyptest-workflow profile checks before writing cases."
    ]
  },
  "scope_in": [
    "scalar integer load/store",
    "compressed memory instructions",
    "floating-point scalar load/store",
    "vector load/store",
    "LR/SC",
    "AMO/AMOCAS",
    "CBO/CMO",
    "fence/sfence",
    "stage1 translation",
    "TLB/PTE cache",
    "PMP/PMA/PBMT",
    "exception priority",
    "trigger/debug",
    "MMIO/device",
    "memtracer/log paths"
  ],
  "scope_out": [
    "H extension instruction entries such as HLV/HSV/HLVX",
    "HS/VS/VU virtualization mode test targets",
    "hgatp/vsatp/henvcfg control paths",
    "stage2 translation",
    "guest page faults and trap_*_guest_page_fault targets"
  ],
  "summary_include_regex": [
    "^riscv/"
  ],
  "summary_exclude_prefixes": [
    "hlv",
    "hlvx",
    "hsv"
  ],
  "summary_exclude_regex": [
    "guest_page_fault",
    "hgatp",
    "vsatp",
    "henvcfg",
